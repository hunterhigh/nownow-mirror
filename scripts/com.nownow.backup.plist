<?xml version="1.0" encoding="UTF-8"?>
<!-- 每天 03:00 自动跑整库备份。启用：
     cp scripts/com.nownow.backup.plist ~/Library/LaunchAgents/
     launchctl load ~/Library/LaunchAgents/com.nownow.backup.plist
     （Mac 那个点没开机会顺延到下次开机后补跑。停用： launchctl unload ...）
     路径必须写成本机仓库的绝对路径。写错不会报错——launchd 只会 exit 127 静默失败，
     日志还只写到 /tmp，没人看。装完请务必按下面「验证」跑一次。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nownow.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/haitao/Desktop/NowNow/scripts/backup-db.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/tmp/nownow-backup.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/nownow-backup.log</string>
</dict>
</plist>
